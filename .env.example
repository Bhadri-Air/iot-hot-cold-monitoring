# InfluxDB 2.x bootstrap (used by docker-compose init)
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=iot-org
INFLUXDB_BUCKET=iot_data
INFLUXDB_TOKEN=iot-super-secret-token

# Redis (ingestion service)
REDIS_HOST=redis
REDIS_PORT=6379

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Simulator (host-side; points at published ingestion port)
INGEST_URL=http://localhost:8000/ingest
SENSOR_ID=plant-1
INTERVAL_SECONDS=2
